<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>shutter_emotion</name>
  <version>0.1.0</version>
  <description>Shutter mirrors human affect (valence, arousal) with 9 scripted behaviors.</description>
  <maintainer email="noreply@example.com">shutter-emotion team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>affect_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>shutter_description</exec_depend>
  <exec_depend>shutter_hardware_interface</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
